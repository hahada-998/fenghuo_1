    DRIVEGND: gnd
      port map (PWR0=>GNDI);
    uart_master_u2_reg_par_data_outce_9: lut40171
      port map (A=>A0_ipd, B=>B0_ipd, C=>C0_ipd, D=>D0_ipd, Z=>F0_out);
