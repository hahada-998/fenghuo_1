    pwrseq_slave_inst_reg_grp_d_vddcore1_en_2_iv_i_o2_4: lut40348
      port map (A=>A0_ipd, B=>B0_ipd, C=>C0_ipd, D=>GNDI, Z=>F0_out);
    DRIVEGND: gnd
      port map (PWR0=>GNDI);
