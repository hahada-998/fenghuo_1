  use IEEE.STD_LOGIC_1164.all;
  use vital2000.vital_timing.all;
  use MACHXO3L.COMPONENTS.ALL;

  entity lut40417 is
    port (A: in Std_logic; B: in Std_logic; C: in Std_logic; D: in Std_logic; 
          Z: out Std_logic);

    ATTRIBUTE Vital_Level0 OF lut40417 : ENTITY IS TRUE;

  end lut40417;

  architecture Structure of lut40417 is
  begin
    INST10: ROM16X1A
      generic map (initval => X"CDCC")
      port map (AD0=>A, AD1=>B, AD2=>C, AD3=>D, DO0=>Z);
  end Structure;

