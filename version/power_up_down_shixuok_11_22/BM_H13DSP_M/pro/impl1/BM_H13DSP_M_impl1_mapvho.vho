      port map (PWR0=>GNDI);
    bios_espi_link_next_state_2_0: lut40302
      port map (A=>A0_ipd, B=>B0_ipd, C=>C0_ipd, D=>D0_ipd, Z=>F0_out);
    pch_cpld_espi_ram_u1_cpu1_pe1_alloc_o_pcie_date_3: vmuxregsre0008
      port map (D0=>M1_dly, D1=>VCCI, SD=>GNDI, SP=>VCCI, CK=>CLK_dly, 
                LSR=>GNDI, Q=>Q1_out);
    DRIVEVCC: vcc
      port map (PWR1=>VCCI);
    pch_cpld_espi_ram_u1_cpu1_pe1_alloc_o_pcie_date_2: vmuxregsre0008
      port map (D0=>M0_dly, D1=>VCCI, SD=>GNDI, SP=>VCCI, CK=>CLK_dly, 
