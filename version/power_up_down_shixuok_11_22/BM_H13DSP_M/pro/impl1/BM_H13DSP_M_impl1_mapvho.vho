  begin
    inst_mcpld_to_scpld_p2s_so_6_u_0_0_0_2: lut40048
      port map (A=>A1_ipd, B=>B1_ipd, C=>C1_ipd, D=>D1_ipd, Z=>F1_out);
    inst_mcpld_to_scpld_p2s_so_6_u_0_0_0_2_RNO: lut40485
      port map (A=>A0_ipd, B=>B0_ipd, C=>C0_ipd, D=>D0_ipd, Z=>F0_out);
    bmc_cpld_i2c_ram_u0_r_reg_0105_1: vmuxregsre0008
      port map (D0=>M1_dly, D1=>VCCI, SD=>GNDI, SP=>CE_dly, CK=>CLK_dly, 
                LSR=>GNDI, Q=>Q1_out);
    DRIVEVCC: vcc
      port map (PWR1=>VCCI);
    DRIVEGND: gnd
      port map (PWR0=>GNDI);
