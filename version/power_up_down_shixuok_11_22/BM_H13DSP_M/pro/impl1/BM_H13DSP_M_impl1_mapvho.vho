      port map (D0=>VCCI, D1=>DI1_dly, SD=>VCCI, SP=>CE_NOTIN, CK=>CLK_dly, 
                LSR=>GNDI, Q=>Q1_out);
    DRIVEVCC: vcc
      port map (PWR1=>VCCI);
