      port map (PWR0=>GNDI);
    pwrseq_master_inst_grp_a_pwrok_timeout_ldmx: lut40175
      port map (A=>A0_ipd, B=>B0_ipd, C=>C0_ipd, D=>D0_ipd, Z=>F0_out);
    pwrseq_master_inst_grp_a_pwrok_timeout: vmuxregsre
      port map (D0=>VCCI, D1=>DI0_dly, SD=>VCCI, SP=>CE_dly, CK=>CLK_dly, 
