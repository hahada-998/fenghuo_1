  entity SLICE_2201 is
    -- miscellaneous vital GENERICs
    GENERIC (
      TimingChecksOn	: boolean := TRUE;
      XOn           	: boolean := FALSE;
      MsgOn         	: boolean := TRUE;
      InstancePath  	: string := "SLICE_2201";

      tipd_C1  	: VitalDelayType01 := (0 ns, 0 ns);
