    DRIVEVCC: vcc
      port map (PWR1=>VCCI);
    timer_gen_inst_t200ms_tmr_0: vmuxregsre0008
      port map (D0=>M0_dly, D1=>VCCI, SD=>GNDI, SP=>CE_dly, CK=>CLK_dly, 
                LSR=>GNDI, Q=>Q0_out);

