    DRIVEVCC: vcc
      port map (PWR1=>VCCI);
    sync_cpu_data_low_dout_13: vmuxregsre
      port map (D0=>M0_dly, D1=>VCCI, SD=>GNDI, SP=>VCCI, CK=>CLK_dly, 
                LSR=>GNDI, Q=>Q0_out);

    --  INPUT PATH DELAYs
