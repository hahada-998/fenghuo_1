    bios_cpld_i2c_ram_u0_i2c_slave_bmc_u0_r_i2c_command_RNI803RA4_2: lut40230
      port map (A=>A0_ipd, B=>B0_ipd, C=>C0_ipd, D=>D0_ipd, Z=>F0_out);
