    .ENCLKOS2(GNDI), .ENCLKOS3(GNDI), .PLLCLK(GNDI), .PLLRST(GNDI), 
    .PLLSTB(GNDI), .PLLWE(GNDI), .PLLDATI7(GNDI), .PLLDATI6(GNDI), 
