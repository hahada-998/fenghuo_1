    .PLLDATI1(GNDI), .PLLDATI0(GNDI), .PLLADDR4(GNDI), .PLLADDR3(GNDI), 
    .PLLADDR2(GNDI), .PLLADDR1(GNDI), .PLLADDR0(GNDI), .CLKOP(CLKOP), 
