    DRIVEVCC: vcc
      port map (PWR1=>VCCI);
    db_power_pg_mInst_13_cnt_13_2: vmuxregsre
      port map (D0=>VCCI, D1=>DI0_dly, SD=>VCCI, SP=>VCCI, CK=>CLK_dly, 
