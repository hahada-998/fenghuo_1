    DRIVEGND: gnd
      port map (PWR0=>GNDI);
    bmc_cpld_i2c_ram_r_reg_0033_3: vmuxregsre
      port map (D0=>M1_dly, D1=>VCCI, SD=>GNDI, SP=>CE_dly, CK=>CLK_dly, 
