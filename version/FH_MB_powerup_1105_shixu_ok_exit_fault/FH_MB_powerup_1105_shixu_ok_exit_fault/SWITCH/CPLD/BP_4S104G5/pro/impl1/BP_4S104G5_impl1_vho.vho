  use IEEE.STD_LOGIC_1164.all;
  use vital2000.vital_timing.all;
  use MACHXO3L.COMPONENTS.ALL;

  entity i_SW2_CLKREQ_N_RB is
    -- miscellaneous vital GENERICs
    GENERIC (
      TimingChecksOn	: boolean := TRUE;
      XOn           	: boolean := FALSE;
      MsgOn         	: boolean := TRUE;
      InstancePath  	: string := "i_SW2_CLKREQ_N_RB";

      tipd_iSW2CLKREQNR  	: VitalDelayType01 := (0 ns, 0 ns);
      tpd_iSW2CLKREQNR_PADDI	 : VitalDelayType01 := (0 ns, 0 ns);
      tperiod_iSW2CLKREQNR 	: VitalDelayType := 0 ns;
      tpw_iSW2CLKREQNR_posedge	: VitalDelayType := 0 ns;
      tpw_iSW2CLKREQNR_negedge	: VitalDelayType := 0 ns);

    port (PADDI: out Std_logic; iSW2CLKREQNR: in Std_logic);

    ATTRIBUTE Vital_Level0 OF i_SW2_CLKREQ_N_RB : ENTITY IS TRUE;

  end i_SW2_CLKREQ_N_RB;

  architecture Structure of i_SW2_CLKREQ_N_RB is
    ATTRIBUTE Vital_Level0 OF Structure : ARCHITECTURE IS TRUE;

    signal PADDI_out 	: std_logic := 'X';
    signal iSW2CLKREQNR_ipd 	: std_logic := 'X';

    component xo2iobuf0423
      port (Z: out Std_logic; PAD: in Std_logic);
    end component;
  begin
    i_SW2_CLKREQ_N_R_pad: xo2iobuf0423
      port map (Z=>PADDI_out, PAD=>iSW2CLKREQNR_ipd);

    --  INPUT PATH DELAYs
    WireDelay : BLOCK
    BEGIN
      VitalWireDelay(iSW2CLKREQNR_ipd, iSW2CLKREQNR, tipd_iSW2CLKREQNR);
    END BLOCK;

    VitalBehavior : PROCESS (PADDI_out, iSW2CLKREQNR_ipd)
    VARIABLE PADDI_zd         	: std_logic := 'X';
    VARIABLE PADDI_GlitchData 	: VitalGlitchDataType;

    VARIABLE tviol_iSW2CLKREQNR_iSW2CLKREQNR          	: x01 := '0';
    VARIABLE periodcheckinfo_iSW2CLKREQNR	: VitalPeriodDataType;

    BEGIN

    IF (TimingChecksOn) THEN
      VitalPeriodPulseCheck (
        TestSignal => iSW2CLKREQNR_ipd,
        TestSignalName => "iSW2CLKREQNR",
        Period => tperiod_iSW2CLKREQNR,
        PulseWidthHigh => tpw_iSW2CLKREQNR_posedge,
        PulseWidthLow => tpw_iSW2CLKREQNR_negedge,
        PeriodData => periodcheckinfo_iSW2CLKREQNR,
        Violation => tviol_iSW2CLKREQNR_iSW2CLKREQNR,
        MsgOn => MsgOn, XOn => XOn,
        HeaderMsg => InstancePath,
        CheckEnabled => TRUE,
        MsgSeverity => warning);

    END IF;

    PADDI_zd 	:= PADDI_out;

    VitalPathDelay01 (
      OutSignal => PADDI, OutSignalName => "PADDI", OutTemp => PADDI_zd,
      Paths      => (0 => (InputChangeTime => iSW2CLKREQNR_ipd'last_event,
                           PathDelay => tpd_iSW2CLKREQNR_PADDI,
                           PathCondition => TRUE)),
      GlitchData => PADDI_GlitchData,
      Mode       => vitaltransport, XOn => XOn, MsgOn => MsgOn);

    END PROCESS;

  end Structure;

