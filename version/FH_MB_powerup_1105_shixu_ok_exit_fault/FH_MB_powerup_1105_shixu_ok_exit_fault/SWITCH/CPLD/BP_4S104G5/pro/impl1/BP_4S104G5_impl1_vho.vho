      VitalWireDelay(iCPLD1HDRR_ipd, iCPLD1HDRR, tipd_iCPLD1HDRR);
    END BLOCK;

    VitalBehavior : PROCESS (PADDI_out, iCPLD1HDRR_ipd)
    VARIABLE PADDI_zd         	: std_logic := 'X';
