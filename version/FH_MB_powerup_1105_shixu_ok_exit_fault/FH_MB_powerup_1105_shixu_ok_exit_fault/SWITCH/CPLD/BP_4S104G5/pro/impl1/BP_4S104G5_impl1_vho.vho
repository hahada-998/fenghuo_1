    DRIVEGND: gnd
      port map (PWR0=>GNDI);
    pon_reset_inst_master_reset_n_i: lut40320
      port map (A=>GNDI, B=>B0_ipd, C=>GNDI, D=>D0_ipd, Z=>F0_out);
    inst_mb_to_slv_s2p_po_r_3: vmuxregsre
