                LSR=>GNDI, Q=>Q0_out);
    uart_master_u2_bps_count_bit_cry_0_3: ccu20001
      port map (A0=>A0_ipd, B0=>B0_ipd, C0=>GNDI, D0=>GNDI, A1=>A1_ipd, 
