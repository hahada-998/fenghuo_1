    DRIVEGND: gnd
      port map (PWR0=>GNDI);
    uart_master_u14_un8_i_a2_0_o2_0: lut40200
      port map (A=>A0_ipd, B=>GNDI, C=>C0_ipd, D=>D0_ipd, Z=>F0_out);
    uart_master_u14_last_state_1: vmuxregsre
      port map (D0=>VCCI, D1=>DI1_dly, SD=>VCCI, SP=>VCCI, CK=>CLK_dly, 
                LSR=>GNDI, Q=>Q1_out);
    DRIVEVCC: vcc
      port map (PWR1=>VCCI);
    uart_master_u14_last_state_0: vmuxregsre
