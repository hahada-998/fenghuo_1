      tpw_CLK_posedge	: VitalDelayType := 0 ns;
      tpw_CLK_negedge	: VitalDelayType := 0 ns);

    port (DI: in Std_logic; LSR: in Std_logic; CLK: in Std_logic; 
          INP: out Std_logic);

