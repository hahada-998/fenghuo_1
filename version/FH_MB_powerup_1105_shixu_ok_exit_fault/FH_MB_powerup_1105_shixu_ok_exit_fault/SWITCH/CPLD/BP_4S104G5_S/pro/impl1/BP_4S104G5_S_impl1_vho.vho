-- entity i_CPLD2_HDR_RB
  library IEEE, vital2000, MACHXO2;
  use IEEE.STD_LOGIC_1164.all;
  use vital2000.vital_timing.all;
  use MACHXO2.COMPONENTS.ALL;

  entity i_CPLD2_HDR_RB is
    -- miscellaneous vital GENERICs
    GENERIC (
      TimingChecksOn	: boolean := TRUE;
      XOn           	: boolean := FALSE;
      MsgOn         	: boolean := TRUE;
      InstancePath  	: string := "i_CPLD2_HDR_RB";

      tipd_iCPLD2HDRR  	: VitalDelayType01 := (0 ns, 0 ns);
      tpd_iCPLD2HDRR_PADDI	 : VitalDelayType01 := (0 ns, 0 ns);
      tperiod_iCPLD2HDRR 	: VitalDelayType := 0 ns;
      tpw_iCPLD2HDRR_posedge	: VitalDelayType := 0 ns;
      tpw_iCPLD2HDRR_negedge	: VitalDelayType := 0 ns);

    port (PADDI: out Std_logic; iCPLD2HDRR: in Std_logic);

    ATTRIBUTE Vital_Level0 OF i_CPLD2_HDR_RB : ENTITY IS TRUE;

  end i_CPLD2_HDR_RB;

  architecture Structure of i_CPLD2_HDR_RB is
    ATTRIBUTE Vital_Level0 OF Structure : ARCHITECTURE IS TRUE;

    signal PADDI_out 	: std_logic := 'X';
    signal iCPLD2HDRR_ipd 	: std_logic := 'X';

    component xo2iobuf0640
      port (Z: out Std_logic; PAD: in Std_logic);
    end component;
  begin
    i_CPLD2_HDR_R_pad: xo2iobuf0640
      port map (Z=>PADDI_out, PAD=>iCPLD2HDRR_ipd);

    --  INPUT PATH DELAYs
    WireDelay : BLOCK
    BEGIN
      VitalWireDelay(iCPLD2HDRR_ipd, iCPLD2HDRR, tipd_iCPLD2HDRR);
    END BLOCK;

    VitalBehavior : PROCESS (PADDI_out, iCPLD2HDRR_ipd)
    VARIABLE PADDI_zd         	: std_logic := 'X';
    VARIABLE PADDI_GlitchData 	: VitalGlitchDataType;

    VARIABLE tviol_iCPLD2HDRR_iCPLD2HDRR          	: x01 := '0';
    VARIABLE periodcheckinfo_iCPLD2HDRR	: VitalPeriodDataType;

    BEGIN

    IF (TimingChecksOn) THEN
      VitalPeriodPulseCheck (
        TestSignal => iCPLD2HDRR_ipd,
        TestSignalName => "iCPLD2HDRR",
        Period => tperiod_iCPLD2HDRR,
        PulseWidthHigh => tpw_iCPLD2HDRR_posedge,
        PulseWidthLow => tpw_iCPLD2HDRR_negedge,
        PeriodData => periodcheckinfo_iCPLD2HDRR,
        Violation => tviol_iCPLD2HDRR_iCPLD2HDRR,
        MsgOn => MsgOn, XOn => XOn,
        HeaderMsg => InstancePath,
        CheckEnabled => TRUE,
        MsgSeverity => warning);

    END IF;

    PADDI_zd 	:= PADDI_out;

    VitalPathDelay01 (
      OutSignal => PADDI, OutSignalName => "PADDI", OutTemp => PADDI_zd,
      Paths      => (0 => (InputChangeTime => iCPLD2HDRR_ipd'last_event,
                           PathDelay => tpd_iCPLD2HDRR_PADDI,
                           PathCondition => TRUE)),
      GlitchData => PADDI_GlitchData,
      Mode       => vitaltransport, XOn => XOn, MsgOn => MsgOn);

    END PROCESS;

  end Structure;

