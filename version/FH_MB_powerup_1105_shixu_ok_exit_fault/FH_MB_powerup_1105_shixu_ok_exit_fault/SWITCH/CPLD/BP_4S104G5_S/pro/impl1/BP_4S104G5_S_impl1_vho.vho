      VitalSignalDelay(CLK_dly, CLK_ipd, ticd_CLK);
    END BLOCK;

    VitalBehavior : PROCESS (B1_ipd, A1_ipd, B0_ipd, A0_ipd, DI1_dly, DI0_dly, 
      CE_dly, CLK_dly, FCI_ipd, F0_out, Q0_out, F1_out, Q1_out, FCO_out)
