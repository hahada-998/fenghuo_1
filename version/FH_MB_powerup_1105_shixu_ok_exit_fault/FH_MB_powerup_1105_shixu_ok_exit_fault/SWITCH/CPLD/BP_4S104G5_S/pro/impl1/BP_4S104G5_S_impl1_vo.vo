  wire   VCCI, GNDI, DI1_dly, CLK_dly, DI0_dly;

  lut40226 \uart_master_u2/curr_state_RNO[1] ( .A(A1), .B(B1), .C(C1), .D(D1), 
    .Z(F1));
  lut40161 \uart_master_u2/curr_state_ns_0_0[0] ( .A(A0), .B(B0), .C(C0), 
    .D(D0), .Z(F0));
