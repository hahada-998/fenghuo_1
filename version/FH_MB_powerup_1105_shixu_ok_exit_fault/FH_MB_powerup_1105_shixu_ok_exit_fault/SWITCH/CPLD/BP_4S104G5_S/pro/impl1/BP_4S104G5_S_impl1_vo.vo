module i_SCPLD_SGPIO_LD_MGIOL ( input DI, LSR, CLK, output IN );
  wire   VCCI, DI_dly, CLK_dly, LSR_dly;

  smuxlregsre0641 \p2s_inst_sld_n_rio[0] ( .D0(DI_dly), .SP(VCCI), 
    .CK(CLK_dly), .LSR(LSR_dly), .Q(IN));
  vcc DRIVEVCC( .PWR1(VCCI));

  specify
    (LSR => IN) = (0:0:0,0:0:0);
