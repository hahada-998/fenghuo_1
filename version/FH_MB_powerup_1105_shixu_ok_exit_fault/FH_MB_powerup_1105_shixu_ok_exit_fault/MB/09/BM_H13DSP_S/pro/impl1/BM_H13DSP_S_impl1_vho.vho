    VitalBehavior : PROCESS (B1_ipd, A1_ipd, A0_ipd, DI1_dly, CE_dly, CLK_dly, 
      F1_out, Q1_out, FCO_out)
    VARIABLE F1_zd         	: std_logic := 'X';
    VARIABLE F1_GlitchData 	: VitalGlitchDataType;
