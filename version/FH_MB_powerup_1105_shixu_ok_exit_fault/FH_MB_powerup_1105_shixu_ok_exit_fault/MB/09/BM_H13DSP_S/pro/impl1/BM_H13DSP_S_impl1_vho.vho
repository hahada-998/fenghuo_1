          F1: out Std_logic; Q1: out Std_logic; FCO: out Std_logic);

    ATTRIBUTE Vital_Level0 OF uart_master_u14_SLICE_92 : ENTITY IS TRUE;

  end uart_master_u14_SLICE_92;

  architecture Structure of uart_master_u14_SLICE_92 is
    ATTRIBUTE Vital_Level0 OF Structure : ARCHITECTURE IS TRUE;

