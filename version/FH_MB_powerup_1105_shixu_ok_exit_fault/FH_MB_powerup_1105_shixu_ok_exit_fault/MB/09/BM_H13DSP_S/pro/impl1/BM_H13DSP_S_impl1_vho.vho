    DRIVEVCC: vcc
      port map (PWR1=>VCCI);
    bmc_cpld_i2c_ram_u0_r_reg_0028_0: vmuxregsre
      port map (D0=>M0_dly, D1=>VCCI, SD=>GNDI, SP=>CE_dly, CK=>CLK_dly, 
