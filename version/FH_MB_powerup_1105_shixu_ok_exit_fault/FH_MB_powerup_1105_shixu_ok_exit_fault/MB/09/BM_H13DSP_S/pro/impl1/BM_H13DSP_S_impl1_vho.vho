      VitalPeriodPulseCheck (
        TestSignal => ioI2C2PAL2SDA_ipd,
        TestSignalName => "ioI2C2PAL2SDA",
        Period => tperiod_ioI2C2PAL2SDA,
        PulseWidthHigh => tpw_ioI2C2PAL2SDA_posedge,
        PulseWidthLow => tpw_ioI2C2PAL2SDA_negedge,
        PeriodData => periodcheckinfo_ioI2C2PAL2SDA,
        Violation => tviol_ioI2C2PAL2SDA_ioI2C2PAL2SDA,
