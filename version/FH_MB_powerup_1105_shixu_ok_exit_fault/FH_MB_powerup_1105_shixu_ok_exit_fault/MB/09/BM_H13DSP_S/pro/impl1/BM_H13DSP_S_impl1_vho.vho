      TimingChecksOn	: boolean := TRUE;
      XOn           	: boolean := FALSE;
      MsgOn         	: boolean := TRUE;
      InstancePath  	: string := "uart_master_u10_SLICE_119";

      tipd_B1  	: VitalDelayType01 := (0 ns, 0 ns);
