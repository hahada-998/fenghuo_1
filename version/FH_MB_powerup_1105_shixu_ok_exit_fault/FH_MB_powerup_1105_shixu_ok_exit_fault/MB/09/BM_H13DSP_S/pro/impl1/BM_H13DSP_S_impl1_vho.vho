    VitalBehavior : PROCESS (D1_ipd, C1_ipd, A1_ipd, D0_ipd, C0_ipd, B0_ipd, 
      A0_ipd, M0_dly, CE_dly, CLK_dly, F0_out, Q0_out, F1_out)
