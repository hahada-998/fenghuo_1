    DRIVEVCC: vcc
      port map (PWR1=>VCCI);
    timer_gen_inst_t1ms: vmuxregsre
      port map (D0=>VCCI, D1=>DI0_dly, SD=>VCCI, SP=>VCCI, CK=>CLK_dly, 
