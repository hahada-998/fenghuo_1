                           PathCondition => TRUE)),
      GlitchData => PADDI_GlitchData,
      Mode       => vitaltransport, XOn => XOn, MsgOn => MsgOn);
    VitalPathDelay01Z (

        OutSignal => ioI2C2PAL2SDA, OutSignalName => "ioI2C2PAL2SDA", OutTemp => ioI2C2PAL2SDA_zd,
      Paths      => (0 => (InputChangeTime => PADDT_ipd'last_event,
                           PathDelay => tpd_PADDT_ioI2C2PAL2SDA,
